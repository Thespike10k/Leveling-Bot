# ─────────────────────────────────────────────
#  AeroX Leveling Bot — Configuration Template
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# [REQUIRED] Discord Bot Token (Get this from Discord Developer Portal)
DISCORD_TOKEN=your-bot-token-here

# [REQUIRED] Discord Client/Application ID
CLIENT_ID=your-client-id-here

# [OPTIONAL] Default command prefix (can be set per-server with /setprefix)
PREFIX=!

# [OPTIONAL] Bot owner Discord ID (for special permissions)
OWNER_ID=your-discord-id-here

# [OPTIONAL] SQLite path (default: ./aerox.db)
DB_PATH=./aerox.db

# [OPTIONAL] UI Assets (Public URLs for the bot's branding)
BANNER_URL=
THUMBNAIL_URL=https://your-public-image-url.com/thumbnail.png
SUPPORT_URL=https://discord.gg/your-support-server
